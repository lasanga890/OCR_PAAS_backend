# Dependency directories
# Node.js dependencies
/node_modules

# Logs and runtime files
# Log files generated by npm
npm-debug.log*

# Other logs
logs
*.log

# Environment variables
# Sensitive environment files that shouldn't be committed
.env
.env.local
.env.production
.env.development
.env.staging

# Build and distribution files
# Common directories for build outputs
/dist
/build
/out
/public/build
/public/dist

# Test coverage
# Directory for test coverage reports
/coverage

# Operating system files
# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
*.stackdump

# IDE and editor files
# Visual Studio Code
.vscode/

# IDE-specific directories and files
.idea/
*.iml
*.iws
*.ipr

# Temporary and miscellaneous files
*.tmp
*.bak
*.swp

# macOS specific lock files and metadata
.lock

# Runtime generated files and folders
/uploads
/pids

# Don't ignore the package-lock.json file, as it's crucial for dependency management.
# It ensures consistent installs across different environments.
# To ignore other lock files, you can be more specific:
# *.lock